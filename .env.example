# Google Gemini API Key (Get a free API key at: https://aistudio.google.com/apikey)
# If no key is provided, the Smart Offline Domain Engine runs automatically.
GEMINI_API_KEY=your_key_here

# Optional Gemini Model (Defaults to gemini-1.5-flash. Can also be gemini-2.0-flash, gemini-2.5-flash, etc.)
# GEMINI_MODEL=gemini-1.5-flash

# Server Port (Optional, defaults to 3000)
PORT=3000

